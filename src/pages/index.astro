---
import { getCollection } from 'astro:content';
import { ArrowUpRight, Download, Github, Linkedin, Mail, MapPin } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import { metrics, skills, experience, principles, education, site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const stats = [metrics[4], metrics[5], ['Team lead', 'scope and release ownership']];
---
<BaseLayout
  title="Nevalen Aginda Prasetyo — Tech Lead"
  description="Tech lead in Jakarta working on payment infrastructure, merchant acquiring, and distributed backend systems. Selected work, engineering principles, and a printable CV."
>
  <Header />
  <CommandPalette />
  <main id="main">
    <section class="grid-paper hero-wash relative overflow-hidden border-b border-line">
      <div class="glow-orb glow-orb--one" aria-hidden="true"></div>
      <div class="glow-orb glow-orb--two" aria-hidden="true"></div>
      <div class="glow-orb glow-orb--three" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 py-14 lg:px-8 lg:py-24">
        <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">Tech Lead · Payment Infrastructure · Jakarta, Indonesia</p>
        <h1 class="mt-6 max-w-4xl text-5xl font-semibold tracking-[-.06em] text-balance sm:text-7xl">Nevalen Aginda Prasetyo</h1>
        <p class="mt-7 max-w-2xl text-lg text-body sm:text-xl">I lead backend delivery for payment infrastructure and merchant acquiring — scheduled payments, QRIS merchant operations, and account verification — on a distributed stack of <span class="text-ink">Node.js, Python, Apache Kafka, MongoDB, and Redis</span>.</p>
        <dl class="mt-10 grid max-w-3xl gap-x-10 gap-y-6 sm:grid-cols-3">
          {stats.map(([value, label]) => <div class="border-t border-line pt-4">
            <dt class="font-mono text-3xl font-semibold gradient-text">{value}</dt>
            <dd class="mt-1 text-sm text-muted">{label}</dd>
          </div>)}
        </dl>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="gradient-cta inline-flex min-h-11 items-center gap-2 rounded px-5 text-sm font-medium no-underline" href="#work">Read selected work <ArrowUpRight size={16} aria-hidden="true" /></a>
          <a class="inline-flex min-h-11 items-center gap-2 rounded border border-line bg-panel px-4 text-sm no-underline hover:border-primary hover:text-primary" href="/cv"><Download size={16} aria-hidden="true" /> Download CV</a>
          <a class="inline-flex min-h-11 items-center gap-2 rounded px-4 text-sm no-underline hover:text-primary" href={`mailto:${site.email}`}><Mail size={16} aria-hidden="true" /> Email me</a>
        </div>
        <dl class="mt-12 grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
          {metrics.slice(0, 4).map(([value, label]) => <div>
            <dt class="font-mono text-sm font-semibold text-ink">{value}</dt>
            <dd class="text-sm text-muted">{label}</dd>
          </div>)}
        </dl>
      </div>
    </section>

    <section id="work" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">01 / Selected work</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Three releases, written up as engineering decisions.</h2>
        <p class="mt-4 text-muted">Case studies use public product facts. Internal architecture, endpoints, and data are left out on purpose.</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {projects.map((project) => <article class="project-card flex flex-col overflow-hidden rounded-lg border border-line bg-panel transition-[transform,box-shadow] duration-200 ease-out motion-reduce:transition-none">
          <img
            class="aspect-[16/10] w-full border-b border-line object-cover object-top"
            src={project.data.image}
            alt={project.data.imageAlt}
            width="1200"
            height="750"
            loading="lazy"
            decoding="async"
          />
          <div class="flex grow flex-col p-6">
            <p class="font-mono text-xs text-primary">{project.data.released}</p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-.035em]"><a class="no-underline project-link" href={`/projects/${project.id.replace(/\.md$/, '')}/`}>{project.data.title}</a></h3>
            <p class="mt-2 text-sm text-muted">{project.data.company}</p>
            <p class="mt-4 text-sm text-body">{project.data.summary}</p>
            <div class="mt-auto pt-6"><a class="inline-flex min-h-11 items-center gap-2 font-mono text-xs uppercase tracking-wide text-primary project-cta" href={`/projects/${project.id.replace(/\.md$/, '')}/`}>Open case study <ArrowUpRight size={15} aria-hidden="true" /></a></div>
          </div>
        </article>)}
      </div>
    </section>

    <section id="toolkit" class="border-y border-line bg-panel scroll-mt-20">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-20">
        <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">02 / Skills</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-[-.04em] sm:text-4xl">What I use, and how often.</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {skills.map((group) => <div class="rounded-lg border border-line bg-paper p-5">
            <h3 class="font-mono text-xs uppercase tracking-[.16em] text-primary">{group.group}</h3>
            <ul class="mt-4 space-y-3">
              {group.items.map(([name, level]) => <li class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-base font-medium">{name}</span>
                <span class="font-mono text-xs text-muted">{level}</span>
              </li>)}
            </ul>
          </div>)}
        </div>
      </div>
    </section>

    <section id="log" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">03 / Experience</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Challenge, solution, impact.</h2>
      <ol class="mt-10 space-y-6">
        {experience.map((entry) => <li class="rounded-lg border border-line bg-panel p-6 lg:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-2xl font-semibold tracking-[-.03em]">{entry.role}</h3>
            <p class="font-mono text-xs text-muted">{entry.when}</p>
          </div>
          <p class="mt-1 text-sm text-muted">{entry.org}</p>
          <dl class="mt-6 grid gap-5 lg:grid-cols-3">
            {[['Challenge', entry.challenge], ['Solution', entry.solution], ['Impact', entry.impact]].map(([term, text]) => <div class="border-t border-line pt-4">
              <dt class="font-mono text-xs uppercase tracking-[.16em] text-primary">{term}</dt>
              <dd class="mt-2 text-sm text-body">{text}</dd>
            </div>)}
          </dl>
          {entry.tech.length > 0 && <ul class="mt-6 flex flex-wrap gap-2">
            {entry.tech.map((t) => <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{t}</li>)}
          </ul>}
        </li>)}
      </ol>
    </section>

    <section id="about" class="border-y border-line bg-panel scroll-mt-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-2 lg:px-8 lg:py-20">
        <div>
          <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">04 / About</p>
          <h2 class="mt-5 text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Physics first, backend after.</h2>
          <div class="mt-6 max-w-xl space-y-4 text-body">
            <p>I started in a physics programme at Universitas Lampung, where the work was mostly measurement, modelling, and defending your conclusions with data. I joined SMBC Indonesia as an IT trainee in October 2021, moved into backend engineering a year later, and now lead backend delivery for the payment and merchant-acquiring platform behind Jenius.</p>
            <p>Team size flexes with the project rather than being fixed, so most of what I actually do is judgement: which state gets stored, which failure is allowed to be visible, which interface other teams will have to live with. I would rather make a boundary explicit than let it be discovered in production.</p>
            <p>Two things I keep returning to: systems fail in the states nobody drew, and a release is not done until someone on-call can debug it.</p>
          </div>
        </div>
        <div class="space-y-10">
          <div>
            <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">Engineering principles</p>
            <dl class="mt-5 space-y-4">
              {principles.map(([title, text]) => <div class="border-l border-primary pl-4">
                <dt class="font-medium">{title}</dt>
                <dd class="mt-1 text-sm text-muted">{text}</dd>
              </div>)}
            </dl>
          </div>
          <div id="education">
            {education.map((e) => <div>
              <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">Education</p>
              <h2 class="mt-5 text-2xl font-semibold">{e.title}</h2>
              <p class="mt-2 text-muted">{e.org} · {e.when}</p>
              <p class="mt-1 font-mono text-sm">{e.detail}</p>
            </div>)}
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">Writing</p>
            <h2 class="mt-5 text-2xl font-semibold">Nothing published yet.</h2>
            <p class="mt-3 max-w-md text-muted">I write notes on payment backends, release review, and backend team practice. When the first one is worth reading, it goes here — not before.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 lg:px-8 lg:py-20">
      <p class="font-mono text-xs uppercase tracking-[.18em] text-primary">05 / Contact</p>
      <h2 class="mt-5 max-w-2xl text-4xl font-semibold tracking-[-.045em] sm:text-5xl">Open to mentoring and technical collaboration.</h2>
      <p class="mt-4 flex items-center gap-2 text-body"><MapPin size={18} aria-hidden="true" /> {site.location}</p>
      <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3">
        <button
          type="button"
          data-copy-email
          class="inline-flex min-h-11 cursor-pointer items-center gap-2 border-0 bg-transparent p-0 font-sans text-ink no-underline hover:text-primary"
          aria-label={`Copy email address ${site.email} to clipboard`}
        >
          <Mail size={18} aria-hidden="true" /><span data-copy-label>Copy email</span>
        </button>
        <a class="inline-flex min-h-11 items-center gap-2" href={site.linkedin} rel="me"><Linkedin size={18} aria-hidden="true" /> LinkedIn</a>
        <a class="inline-flex min-h-11 items-center gap-2" href={site.github} rel="me"><Github size={18} aria-hidden="true" /> GitHub</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .project-card { --hover-lift: -4px; }
  .project-card:hover { transform: translateY(var(--hover-lift)); box-shadow: 0 18px 40px -24px color-mix(in oklab, var(--color-primary) 55%, transparent); }
  .project-link {
    background-image: linear-gradient(var(--color-primary), var(--color-primary));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 2px;
    transition: background-size 200ms ease-out;
  }
  .project-card:nth-child(1):hover .project-link { background-size: 100% 2px; }
  .project-card:nth-child(2):hover .project-link { text-decoration: underline; text-decoration-color: var(--color-secondary); text-underline-offset: 5px; }
  .project-cta { transition: transform 200ms ease-out; }
  .project-card:nth-child(3):hover .project-cta { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .project-card, .project-link, .project-cta { transition: none; }
    .project-card:hover { transform: none; }
    .project-card:nth-child(3):hover .project-cta { transform: none; }
  }
</style>
<script>
  const btn = document.querySelector<HTMLElement>('[data-copy-email]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
  const email = 'nevalenaginda10@gmail.com';
  if (btn && label) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied ✓';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => { label.textContent = 'Copy email'; }, 2000);
    });
  }
</script>
