---
import { getCollection } from 'astro:content';
import {
  ArrowUpRight, Atom, AudioLines, Copy, Download, Eye, Flame, Github, Grab, GraduationCap, Lightbulb, Linkedin, MapPin,
  Orbit, PenLine, Radar, Radio, ScanLine, ScanSearch, Send, Sparkles, Target, Wrench,
} from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import ArisSlot from '../components/ArisSlot.astro';
import SolarDeck from '../components/SolarDeck.astro';
import { metrics, modules, parts, experience, principles, education, site, type Part } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const levels: Record<string, string> = { 'Daily use': 'led', 'Working knowledge': 'led led--cyan', 'Practice area': 'led led--violet', Learning: 'led led--amber' };
const inspectIcons: Record<Part, typeof Eye> = { visor: Eye, reactor: Atom, manipulator: Grab, thruster: Flame };
const steps = [
  { term: 'Challenge', icon: Target, ink: 'text-rose' },
  { term: 'Solution', icon: Wrench, ink: 'text-violet' },
  { term: 'Impact', icon: Sparkles, ink: 'text-teal' },
] as const;
const platforms = (stores: { store: string }[]) => stores.map(({ store }) => (store === 'App Store' ? 'iOS' : 'Android'));
---
<BaseLayout
  title="Nevalen Aginda Prasetyo — Tech Lead"
  description="Tech lead in Jakarta working on payment infrastructure, merchant acquiring, and distributed backend systems, guided through the site by ARIS-1, an interactive 3D astronaut robot."
>
  <Header audio />
  <CommandPalette />
  <main id="main" class="solar-hide">
    <section id="viewport" class="relative scroll-mt-24" data-section="viewport" data-wash="teal">
      <div class="mx-auto grid max-w-6xl items-center gap-6 px-5 pb-8 pt-8 lg:grid-cols-[1.15fr_.85fr] lg:gap-10 lg:px-8 lg:pt-12">
        <div class="order-2 lg:order-1">
          <p class="intro eyebrow" style="--d:0ms">Online · Jakarta, Indonesia</p>
          <h1 class="mt-5 text-[2.15rem] leading-[1.08] text-balance sm:text-6xl xl:text-[4.1rem]" data-split>Nevalen Aginda <span class="gradient-text">Prasetyo</span></h1>
          <p class="intro mt-4 font-mono text-sm uppercase tracking-[.16em] text-cyan" style="--d:180ms">Tech Lead · Payment infrastructure &amp; merchant acquiring</p>
          <p class="intro mt-5 max-w-[38rem] text-lg text-body" style="--d:260ms">I lead backend delivery for the payment and merchant-acquiring platform behind Jenius: scheduled payments, QRIS merchant operations, and account verification, on a distributed stack of <span class="font-semibold text-ink">Node.js, Python, Apache Kafka, MongoDB, and Redis</span>.</p>
          <dl class="intro mt-8 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4" style="--d:360ms">
            {metrics.slice(0, 4).map(([value, label]) => <div class="bg-hull/90 px-4 py-3">
              <dt class="font-display text-lg text-ink sm:text-xl">{value}</dt>
              <dd class="mt-1 text-xs leading-snug text-muted">{label}</dd>
            </div>)}
          </dl>
          <div class="intro mt-8 flex flex-wrap gap-3" style="--d:520ms">
            <a class="btn btn--primary" href="#missions">Deployed missions <ArrowUpRight size={16} aria-hidden="true" /></a>
            <a class="btn btn--ghost" href="/cv"><Download size={16} aria-hidden="true" /> Download CV</a>
            <a class="btn btn--ghost" href="#contact"><Radio size={16} aria-hidden="true" /> Open comms</a>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <ArisSlot />
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-5 pb-16 lg:px-8 lg:pb-20">
        <div class="panel brackets scanlines intro overflow-hidden" style="--d:640ms" data-hud>
          <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5">
            <p class="hud-label flex items-center gap-2"><span class="led"></span> ARIS-1 · Heads-up display</p>
            <p class="hud-label">MET <span class="text-ink" data-tm="met">00:00</span></p>
          </div>
          <div class="grid divide-y divide-line lg:grid-cols-[1.3fr_1fr_1fr] lg:divide-x lg:divide-y-0">
            <dl class="grid grid-cols-2 gap-x-4 gap-y-3 p-4 sm:grid-cols-3">
              <div><dt class="hud-label">System</dt><dd class="hud-value" data-tm="sys">STANDBY</dd></div>
              <div><dt class="hud-label">Mode</dt><dd class="hud-value" data-tm="mode">INSPECT</dd></div>
              <div><dt class="hud-label">Frame rate</dt><dd class="hud-value"><span data-tm="fps">—</span> <span class="text-xs text-muted">fps</span></dd></div>
              <div><dt class="hud-label">Pos X</dt><dd class="hud-value" data-tm="x">+0000</dd></div>
              <div><dt class="hud-label">Pos Y</dt><dd class="hud-value" data-tm="y">+0000</dd></div>
              <div><dt class="hud-label">Thruster</dt><dd class="hud-value" data-tm="thrust">IDLE</dd>
                <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-line"><div class="h-full origin-left scale-x-0 bg-amber transition-transform duration-150" data-tm-bar="thrust"></div></div>
              </div>
              <div class="col-span-2"><dt class="hud-label">Scan</dt><dd class="hud-value" data-tm="scan">STANDBY</dd>
                <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-line"><div class="h-full origin-left scale-x-0 bg-teal transition-transform duration-150" data-tm-bar="scan"></div></div>
              </div>
              <div><dt class="hud-label">Target</dt><dd class="hud-value truncate" data-tm="target">—</dd></div>
            </dl>
            <div class="p-4">
              <p class="hud-label">Flight mode</p>
              <div class="mt-2 grid grid-cols-2 gap-2" role="group" aria-label="Flight mode">
                <button class="btn btn--ghost !px-3" type="button" data-mode="inspect" aria-pressed="true"><ScanSearch size={16} aria-hidden="true" /> Inspect</button>
                <button class="btn btn--ghost !px-3" type="button" data-mode="solar" aria-pressed="false"><Orbit size={16} aria-hidden="true" /> Solar flight</button>
              </div>
              <p class="hud-label mt-4">Quick actions</p>
              <div class="mt-2 grid gap-2">
                <button class="btn btn--ghost" type="button" data-action="scan-all"><Radar size={16} aria-hidden="true" /> Scan all specs</button>
                <button class="btn btn--ghost" type="button" data-audio-toggle="voice" aria-pressed="false"><AudioLines size={16} aria-hidden="true" /> Voice assistant · <span data-audio-state>Off</span></button>
              </div>
              <p class="mt-3 text-xs text-amber" data-static-note hidden></p>
            </div>
            <div class="p-4">
              <p class="hud-label">Quick inspection</p>
              <div class="mt-2 grid grid-cols-2 gap-2">
                {(Object.keys(parts) as Part[]).map((part) => {
                  const Icon = inspectIcons[part];
                  return <button class="btn btn--ghost !justify-start !px-3" type="button" data-inspect={part} aria-pressed="false" title={`Inspect the ${parts[part].label.toLowerCase()}: ${parts[part].module}`}><Icon size={16} aria-hidden="true" /> {parts[part].label}</button>;
                })}
              </div>
              <p class="mt-3 text-xs leading-relaxed text-muted">Each part stands for one system module below.<span data-needs-3d> Click ARIS-1 itself to say hello.</span></p>
            </div>
          </div>
          <p class="border-t border-line px-4 py-2.5 font-mono text-xs text-teal" role="status" aria-live="polite" data-aris-readout>ARIS-1 › Systems nominal. Awaiting command.</p>
        </div>
      </div>
    </section>

    <section id="specs" class="scroll-mt-24" data-section="specs" data-wash="cyan">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
        <p class="eyebrow" data-reveal>02 / System architecture</p>
        <h2 class="mt-5 max-w-2xl text-4xl text-balance sm:text-5xl" data-split="mask">The modules I run on.</h2>
        <p class="mt-4 max-w-2xl text-body" data-reveal>Four modules built from eleven skills, each with how often I use it. Hover a module and ARIS-1 flies over to scan it; click it to hear the readout.</p>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-muted" aria-label="Usage levels" data-reveal>
          {Object.entries(levels).map(([name, cls]) => <li class="flex items-center gap-2"><span class={cls} aria-hidden="true"></span>{name}</li>)}
        </ul>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {modules.map((m) => <article
            class="panel brackets scan-card cursor-pointer p-6"
            data-reveal="card"
            data-tilt
            data-scan
            data-scan-click
            data-scan-label={`${m.code} · ${m.name}`}
            data-scan-say={m.say}
            data-scan-part={m.part}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <p class="font-mono text-xs tracking-[.22em] text-teal">{m.code}</p>
              <p class="chip">Part · {parts[m.part].label}</p>
            </div>
            <h3 class="mt-4 font-display text-lg tracking-[.08em] sm:text-xl">{m.name}</h3>
            <p class="mt-1 text-sm text-muted">{m.role}</p>
            <ul class="mt-5 space-y-2">
              {m.items.map(([name, level]) => <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-space/70 px-3 py-2">
                <span class="font-medium text-ink">{name}</span>
                <span class="flex items-center gap-2 font-mono text-xs text-muted"><span class={levels[level]} aria-hidden="true"></span>{level}</span>
              </li>)}
            </ul>
            <button class="btn btn--ghost mt-5 w-full" type="button" data-scan-btn><ScanLine size={16} aria-hidden="true" /> Scan module</button>
          </article>)}
        </div>
      </div>
    </section>

    <section id="missions" class="scroll-mt-24" data-section="missions" data-wash="violet">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow" data-reveal>03 / Deployed missions</p>
          <h2 class="mt-5 text-4xl text-balance sm:text-5xl" data-split="mask">Three releases in production.</h2>
          <p class="mt-4 text-body" data-reveal>Each case study is based on publicly available product information. Internal architecture, endpoints, and data are intentionally excluded.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {projects.map((project, i) => <article
            class="panel brackets scan-card group relative flex flex-col"
            data-reveal="card"
            data-tilt
            data-scan
            data-scan-label={`MSN-0${i + 1} · ${project.data.title}`}
            data-scan-say={`Mission ${i + 1}: ${project.data.title}. Released ${project.data.released}. Role: ${project.data.role}. ${project.data.summary}`}
          >
            <div class="relative m-3 overflow-hidden rounded-xl border border-line" data-reveal="image">
              <img
                class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
                src={project.data.image}
                alt={project.data.imageAlt}
                width="1200"
                height="750"
                loading="lazy"
                decoding="async"
                style={`view-transition-name: shot-${project.id}`}
              />
              <span class="chip absolute left-3 top-3 !border-teal/40 bg-void/85 text-teal"><span class="led" aria-hidden="true"></span> Deployed</span>
            </div>
            <div class="flex grow flex-col px-5 pb-5 pt-1">
              <p class="font-mono text-xs tracking-[.2em] text-teal">MSN-0{i + 1} · {project.data.released}</p>
              <h3 class="mt-2 text-2xl" style={`view-transition-name: title-${project.id}`}><a class="no-underline after:absolute after:inset-0 after:z-[2] after:content-['']" href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
              <p class="mt-1 text-sm text-muted">{project.data.role} · {project.data.company}</p>
              <p class="mt-3 text-[.95rem] text-body">{project.data.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Platforms">
                {platforms(project.data.stores).map((p) => <li class="chip">{p}</li>)}
              </ul>
              <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[.14em] text-teal">Open mission brief <ArrowUpRight class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" size={15} aria-hidden="true" /></span>
                <button class="icon-btn relative z-[3]" type="button" data-scan-btn aria-label={`Scan ${project.data.title}`} title="Scan this mission"><ScanLine size={18} aria-hidden="true" /></button>
              </div>
            </div>
          </article>)}
        </div>
      </div>
    </section>

    <section id="log" class="scroll-mt-24" data-section="log" data-wash="amber">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
        <p class="eyebrow" data-reveal>04 / Flight log</p>
        <h2 class="mt-5 max-w-2xl text-4xl sm:text-5xl" data-split="mask">Challenge, solution, impact.</h2>
        <div class="relative mt-12">
          <div class="absolute bottom-6 left-[.95rem] top-6 w-px origin-top bg-gradient-to-b from-teal via-violet to-amber sm:left-[1.2rem]" data-draw aria-hidden="true"></div>
          <ol class="space-y-6">
            {experience.map((entry, i) => <li class="relative pl-10 sm:pl-14" data-reveal="card">
              <span class="absolute left-0 top-7 grid size-8 place-items-center rounded-full border border-line-bright bg-hull sm:size-10" aria-hidden="true"><span class={i === 0 ? 'led' : 'led led--off'}></span></span>
              <article
                class="panel brackets scan-card cursor-pointer p-5 lg:p-7"
                data-scan
                data-scan-click
                data-scan-label={`LOG-0${experience.length - i} · ${entry.role}`}
                data-scan-say={`${entry.role}, ${entry.org}, ${entry.when}. ${entry.impact}`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                  <h3 class="text-2xl sm:text-3xl">{entry.role}</h3>
                  <p class="chip text-amber">{entry.when}</p>
                </div>
                <p class="mt-1 font-medium text-muted">{entry.org}</p>
                <dl class="mt-5 grid gap-3 lg:grid-cols-3">
                  {steps.map(({ term, icon: Icon, ink }) => <div class="rounded-xl border border-line bg-space/70 p-4">
                    <dt class={`flex items-center gap-2 font-mono text-xs uppercase tracking-[.16em] ${ink}`}><Icon size={15} aria-hidden="true" /> {term}</dt>
                    <dd class="mt-2 text-[.95rem] text-body">{term === 'Challenge' ? entry.challenge : term === 'Solution' ? entry.solution : entry.impact}</dd>
                  </div>)}
                </dl>
                {entry.tech.length > 0 && <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
                  {entry.tech.map((t) => <li class="chip">{t}</li>)}
                </ul>}
              </article>
            </li>)}
          </ol>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-[1.15fr_1fr]">
          <div class="panel p-6 lg:p-8" data-reveal>
            <p class="hud-label">Pilot dossier</p>
            <h3 class="mt-3 text-3xl">Physics first, backend after.</h3>
            <div class="mt-5 space-y-4 text-body">
              <p>I studied physics at Universitas Lampung, where most of the work was measurement, modelling, and backing conclusions with data. I joined SMBC Indonesia as an IT trainee in October 2021, moved into backend engineering a year later, and now lead backend delivery for the payment and merchant-acquiring platform behind Jenius.</p>
              <p>Team size changes from project to project, so much of my role is making technical decisions early: what state to store, how failures should surface, and which interfaces other teams will rely on. I prefer to define these boundaries clearly before release rather than discover them in production.</p>
              <p>I pay particular attention to edge cases and to operability: a release is complete only when the on-call team can support it.</p>
            </div>
          </div>
          <div class="grid gap-6">
            <div class="panel p-6" data-reveal>
              <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[.16em] text-teal"><Lightbulb size={16} aria-hidden="true" /> Mission directives</p>
              <dl class="mt-4 space-y-3">
                {principles.map(([title, text]) => <div class="rounded-xl border border-line bg-space/70 p-4">
                  <dt class="flex items-center gap-2 font-semibold text-ink"><span class="led led--off !bg-teal/70" aria-hidden="true"></span>{title}</dt>
                  <dd class="mt-1 text-[.95rem] text-muted">{text}</dd>
                </div>)}
              </dl>
            </div>
            <div id="education" class="panel scroll-mt-24 p-6" data-reveal>
              {education.map((e) => <div>
                <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[.16em] text-cyan"><GraduationCap size={16} aria-hidden="true" /> Education</p>
                <h3 class="mt-3 text-2xl">{e.title}</h3>
                <p class="mt-1 text-body">{e.org} · {e.when}</p>
                <p class="mt-1 font-mono text-sm text-muted">{e.detail}</p>
              </div>)}
              <p class="mt-5 flex items-center gap-2 border-t border-line pt-4 font-mono text-xs uppercase tracking-[.16em] text-violet"><PenLine size={15} aria-hidden="true" /> Writing</p>
              <p class="mt-2 text-[.95rem] text-body">Nothing published yet. I am preparing notes on payment backends, release reviews, and backend team practices.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24" data-section="contact" data-wash="rose">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
        <p class="eyebrow" data-reveal>05 / Comms terminal</p>
        <h2 class="mt-5 max-w-2xl text-4xl text-balance sm:text-5xl" data-split="mask">Open to mentoring and technical collaboration.</h2>
        <div class="mt-12 grid gap-6 lg:grid-cols-[1.45fr_1fr]">
          <div class="panel brackets overflow-hidden" data-reveal>
            <div class="flex items-center justify-between gap-3 border-b border-line bg-void/50 px-4 py-2.5">
              <p class="flex items-center gap-2" aria-hidden="true"><span class="size-2.5 rounded-full bg-rose/80"></span><span class="size-2.5 rounded-full bg-amber/80"></span><span class="size-2.5 rounded-full bg-teal/80"></span></p>
              <p class="truncate font-mono text-xs text-muted">comms://nevalen@jakarta</p>
              <p class="hud-label flex items-center gap-2"><span class="led"></span> Open</p>
            </div>
            <ol class="terminal-log scanlines" data-terminal-log aria-live="polite" aria-label="Terminal log">
              <li>&gt; ARIS-1 comms terminal ready</li>
              <li>&gt; link to Jakarta ground station: up</li>
              <li data-tone="aris">Fill in the three fields and transmit. Your message goes out through your own mail app; nothing is stored here.</li>
            </ol>
            <form class="grid gap-3 p-4 sm:p-5" data-terminal data-email={site.email} novalidate>
              <label class="terminal-field"><span>sender.name&gt;</span><input name="name" required maxlength="80" autocomplete="name" data-label="your name" placeholder="Ada Lovelace" /></label>
              <label class="terminal-field"><span>sender.email&gt;</span><input name="email" type="email" required autocomplete="email" data-label="your email" placeholder="ada@example.com" /></label>
              <label class="terminal-field terminal-field--area"><span>signal.message&gt;</span><textarea name="message" required minlength="10" maxlength="2000" rows="5" data-label="the message" placeholder="Hi Nevalen, I'd like to talk about…"></textarea></label>
              <div class="flex flex-wrap gap-2 pt-1">
                <button class="btn btn--primary" type="submit"><Send size={16} aria-hidden="true" /> Transmit signal</button>
                <button class="btn btn--ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
          <aside class="panel flex flex-col gap-3 p-6" data-reveal aria-label="Direct channels">
            <p class="hud-label">Direct channels</p>
            <p class="break-all font-mono text-sm text-ink">{site.email}</p>
            <button class="btn btn--ghost w-full" type="button" data-copy-email={site.email} aria-label={`Copy email address ${site.email} to clipboard`}>
              <Copy size={16} aria-hidden="true" /><span data-copy-label>Copy email</span>
            </button>
            <a class="btn btn--ghost w-full" href={site.linkedin} rel="me"><Linkedin size={16} aria-hidden="true" /> LinkedIn</a>
            <a class="btn btn--ghost w-full" href={site.github} rel="me"><Github size={16} aria-hidden="true" /> GitHub</a>
            <a class="btn btn--ghost w-full" href="/cv"><Download size={16} aria-hidden="true" /> Printable CV</a>
            <p class="mt-auto flex items-center gap-2 pt-3 text-sm text-muted"><MapPin size={16} aria-hidden="true" /> {site.location} · UTC+7</p>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <SolarDeck />
  <Footer />
</BaseLayout>
<script>
  import '../scripts/aris/controller';
  import '../scripts/aris/terminal';
</script>
