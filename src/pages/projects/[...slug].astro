---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, Briefcase, CalendarDays, UserRound } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import Footer from '../../components/Footer.astro';
import RobotPoster from '../../components/RobotPoster.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const facts = [
  { term: 'Company', value: project.data.company, icon: Briefcase, bg: 'bg-grape-soft', ink: 'text-grape-ink' },
  { term: 'Role', value: project.data.role, icon: UserRound, bg: 'bg-pink-soft', ink: 'text-pink-ink' },
  { term: 'Released', value: project.data.released, icon: CalendarDays, bg: 'bg-mint-soft', ink: 'text-mint-ink' },
];
---
<BaseLayout title={`${project.data.title} — Nevalen Aginda Prasetyo`} description={project.data.summary}>
  <Header />
  <CommandPalette />
  <main id="main" class="relative overflow-hidden">
    <div class="blob blob--grape -right-24 -top-10 size-[24rem]" data-parallax="0.15" aria-hidden="true"></div>
    <div class="blob blob--sun -left-28 top-[28rem] size-[20rem]" data-parallax="-0.1" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
      <a class="inline-flex min-h-11 items-center gap-2 rounded-full bg-panel px-4 text-sm font-bold text-grape-ink no-underline shadow-sm transition-transform hover:-translate-x-1" href="/#work"><ArrowLeft size={16} aria-hidden="true" /> Selected work</a>
      <article class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div>
          <p class="intro eyebrow bg-sun-soft text-sun-ink">Case study / {project.data.released}</p>
          <h1 class="intro mt-5 max-w-3xl text-4xl text-balance sm:text-6xl" style="--d:80ms">{project.data.title}</h1>
          <p class="intro mt-5 max-w-2xl text-lg text-body sm:text-xl" style="--d:160ms">{project.data.summary}</p>
          <div class="mt-10 rounded-[2rem] border-2 border-line bg-panel p-3 shadow-[0_8px_0_0_var(--color-line)]">
            <img
              class="w-full rounded-[1.4rem] object-cover object-top"
              src={project.data.image}
              alt={project.data.imageAlt}
              width="1200"
              height="750"
              loading="eager"
              decoding="async"
              style={`view-transition-name: shot-${project.id}`}
            />
          </div>
          <p class="mt-3 font-mono text-xs text-muted">Public product page — no internal data or interface.</p>
          <div class="case-study mt-14 max-w-[65ch] text-body"><Content /></div>
        </div>
        <aside class="h-fit space-y-3 lg:sticky lg:top-28">
          <dl class="space-y-3">
            {facts.map(({ term, value, icon: Icon, bg, ink }) => <div class={`rounded-3xl ${bg} p-4`} data-reveal>
              <dt class={`flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wide ${ink}`}><Icon size={15} aria-hidden="true" /> {term}</dt>
              <dd class="mt-1 font-semibold">{value}</dd>
            </div>)}
          </dl>
          <a class="btn btn--primary w-full justify-center" href={project.data.reference}>Public reference <ArrowUpRight size={18} aria-hidden="true" /></a>
          <div class="hidden rounded-3xl bg-panel p-4 lg:block" aria-hidden="true">
            <RobotPoster class="mx-auto h-40 w-auto" />
          </div>
        </aside>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
<style>
  .case-study :global(h2) {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-top: 3rem;
    color: var(--color-ink);
    font-size: 1.75rem;
  }
  .case-study :global(h2)::before {
    content: '';
    width: .9rem;
    height: .9rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-bubblegum);
    box-shadow: 0 0 0 5px var(--color-pink-soft);
  }
  .case-study :global(h2:nth-of-type(3n+2))::before { background: var(--color-grape); box-shadow: 0 0 0 5px var(--color-grape-soft); }
  .case-study :global(h2:nth-of-type(3n))::before { background: var(--color-mint); box-shadow: 0 0 0 5px var(--color-mint-soft); }
  .case-study :global(h2:first-child) { margin-top: 0; }
  .case-study :global(p), .case-study :global(ul) { margin-top: 1rem; }
  .case-study :global(ul) { list-style: none; padding-left: 0; }
  .case-study :global(li) { position: relative; margin-top: .6rem; padding-left: 1.6rem; }
  .case-study :global(li)::before { content: '✦'; position: absolute; left: 0; color: var(--color-grape-ink); }
  .case-study :global(a) { color: var(--color-primary); font-weight: 600; }
  .case-study :global(strong) { color: var(--color-ink); }
</style>
