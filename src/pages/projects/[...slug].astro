---
import { getCollection, render } from 'astro:content';
import { Apple, ArrowLeft, ArrowUpRight, Briefcase, CalendarDays, Play, UserRound } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import Footer from '../../components/Footer.astro';
import ReadingGuide from '../../components/ReadingGuide.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const missions = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const code = `MSN-0${missions.findIndex((p) => p.id === project.id) + 1}`;
// ARIS-1's reading guide: the case study's parts, and a reading time at about 220 words a minute.
const parts = headings.filter((h) => h.depth === 2).map(({ slug, text }) => ({ slug, text }));
const minutes = Math.max(1, Math.ceil((project.body ?? '').split(/\s+/).filter(Boolean).length / 220));
const facts = [
  { term: 'Company', value: project.data.company, icon: Briefcase, ink: 'text-teal' },
  { term: 'Role', value: project.data.role, icon: UserRound, ink: 'text-violet' },
  { term: 'Released', value: project.data.released, icon: CalendarDays, ink: 'text-amber' },
];
---
<BaseLayout title={`${project.data.title} — Nevalen Aginda Prasetyo`} description={project.data.summary}>
  <Header />
  <CommandPalette />
  <main id="main" class="relative overflow-x-clip">
    <div class="relative mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
      <a class="btn btn--ghost !min-h-11" href="/#missions"><ArrowLeft size={16} aria-hidden="true" /> Deployed missions</a>
      <article class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div>
          <p class="intro eyebrow">Mission brief · {code} · {project.data.released}</p>
          <h1 class="intro mt-5 max-w-3xl text-3xl leading-tight text-balance sm:text-5xl" style={`--d:80ms; view-transition-name: title-${project.id}`}>{project.data.title}</h1>
          <p class="intro mt-5 max-w-2xl text-lg text-body sm:text-xl" style="--d:160ms">{project.data.summary}</p>
          <div class="panel brackets mt-10 p-3">
            <img
              class="w-full rounded-xl object-cover object-top"
              src={project.data.image}
              alt={project.data.imageAlt}
              width="1200"
              height="750"
              loading="eager"
              decoding="async"
              style={`view-transition-name: shot-${project.id}`}
            />
          </div>
          <p class="mt-3 font-mono text-xs text-muted">Public product page — no internal data or interface.</p>
          <div class="case-study mt-14 max-w-[65ch] text-body"><Content /></div>
        </div>
        <aside class="space-y-3">
          <dl class="space-y-3">
            {facts.map(({ term, value, icon: Icon, ink }) => <div class="panel p-4" data-reveal>
              <dt class={`flex items-center gap-2 font-mono text-xs uppercase tracking-[.16em] ${ink}`}><Icon size={15} aria-hidden="true" /> {term}</dt>
              <dd class="mt-1 font-medium text-ink">{value}</dd>
            </div>)}
          </dl>
          <a class="btn btn--primary w-full" href={project.data.reference}>Public reference <ArrowUpRight size={16} aria-hidden="true" /></a>
          {project.data.stores.length > 0 && <div class="panel p-4">
            <p class="hud-label">Get the app</p>
            <ul class="mt-3 space-y-2">
              {project.data.stores.map(({ store, url }) => <li><a class="btn btn--ghost w-full" href={url} rel="noopener">{store === 'App Store' ? <Apple size={16} aria-hidden="true" /> : <Play size={16} aria-hidden="true" />} {store}</a></li>)}
            </ul>
            {project.data.stores.every(({ store }) => store === 'Google Play') && <p class="mt-2 text-center text-xs text-muted">Available on Android only.</p>}
          </div>}
          <ReadingGuide headings={parts} minutes={minutes} />
        </aside>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
<style>
  .case-study :global(h2) {
    scroll-margin-top: 7rem;
    display: flex;
    align-items: center;
    gap: .7rem;
    margin-top: 3rem;
    font-size: 1.6rem;
  }
  .case-study :global(h2)::before {
    content: '';
    width: .55rem;
    height: .55rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-teal);
    box-shadow: 0 0 12px var(--color-teal);
  }
  .case-study :global(h2:nth-of-type(3n+2))::before { background: var(--color-violet); box-shadow: 0 0 12px var(--color-violet); }
  .case-study :global(h2:nth-of-type(3n))::before { background: var(--color-amber); box-shadow: 0 0 12px var(--color-amber); }
  .case-study :global(h2:first-child) { margin-top: 0; }
  .case-study :global(p), .case-study :global(ul) { margin-top: 1rem; }
  .case-study :global(ul) { list-style: none; padding-left: 0; }
  .case-study :global(li) { position: relative; margin-top: .6rem; padding-left: 1.6rem; }
  .case-study :global(li)::before { content: '▸'; position: absolute; left: 0; color: var(--color-teal); }
  .case-study :global(a) { color: var(--color-teal); font-weight: 500; }
  .case-study :global(strong) { color: var(--color-ink); }
</style>
