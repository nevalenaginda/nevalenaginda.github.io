---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const { title = 'Nevalen Aginda Prasetyo — Software Engineer Technical Lead', description = 'Backend systems for payments, merchant operations, and secure identity journeys.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-moss focus:px-4 focus:py-3 focus:text-paper" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
