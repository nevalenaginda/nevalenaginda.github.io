---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}
const {
  title = 'Nevalen Aginda Prasetyo — Tech Lead',
  description = 'Tech lead in Jakarta working on payment infrastructure, merchant acquiring, and distributed backend systems.',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL('/og.png', Astro.site).href,
} = Astro.props;
const siteName = site.name;
const handle = '@nevalenaginda10';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  jobTitle: site.role,
  url: new URL('/', Astro.site).href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  sameAs: [site.linkedin, site.github],
  knowsAbout: ['Node.js', 'Python', 'Apache Kafka', 'MongoDB', 'Redis', 'Distributed systems', 'Payment systems', 'Merchant acquiring', 'Backend delivery leadership'],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={handle} />
    <meta name="twitter:creator" content={handle} />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      // Runs before paint so the stored theme does not flash the wrong colours.
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-primary focus:px-4 focus:py-3 focus:text-white" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
