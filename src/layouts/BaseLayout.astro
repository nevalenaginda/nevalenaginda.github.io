---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '../styles/global.css';
import { site } from '../data/site';
import Motion from '../components/Motion.astro';
import jakarta400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import jakarta600 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-600-normal.woff2?url';
import fredoka600 from '@fontsource/fredoka/files/fredoka-latin-600-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  /** false skips smooth scroll and scroll animations (the printable CV). */
  playful?: boolean;
}
const {
  title = 'Nevalen Aginda Prasetyo — Tech Lead',
  description = 'Tech lead in Jakarta working on payment infrastructure, merchant acquiring, and distributed backend systems.',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL('/og.png', Astro.site).href,
  playful = true,
} = Astro.props;
const siteName = site.name;
const handle = '@nevalenaginda10';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  jobTitle: site.role,
  url: new URL('/', Astro.site).href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  sameAs: [site.linkedin, site.github],
  knowsAbout: ['Node.js', 'Python', 'Apache Kafka', 'MongoDB', 'Redis', 'Distributed systems', 'Payment systems', 'Merchant acquiring', 'Backend delivery leadership'],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={handle} />
    <meta name="twitter:creator" content={handle} />
    <script type="application/ld+json" set:html={jsonLd} />
    <meta name="theme-color" content="#f5fbf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {playful && [jakarta400, jakarta600, fredoka600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {playful && <script is:inline>
      // Runs before paint: [data-reveal] elements start hidden only when JS will reveal them.
      var html = document.documentElement;
      html.classList.add('js');
      try {
        // Coming back with the browser's back button: show everything at once, no second reveal.
        if (performance.getEntriesByType('navigation')[0].type === 'back_forward') html.classList.add('returning');
      } catch (e) {}
      // Page transitions: going back to the home page wipes downward instead of upward.
      addEventListener('pagereveal', function (e) {
        var nav = /** @type {any} */ (window).navigation;
        if (!e.viewTransition || !nav || !nav.activation) return;
        var from = nav.activation.from && nav.activation.from.url;
        var back = nav.activation.navigationType === 'traverse'
          || (from && new URL(from).pathname.indexOf('/projects/') === 0 && location.pathname === '/');
        if (back) e.viewTransition.types.add('back');
      });
    </script>}
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-3 focus:text-white" href="#main">Skip to content</a>
    <slot />
    {playful && <Motion />}
  </body>
</html>
