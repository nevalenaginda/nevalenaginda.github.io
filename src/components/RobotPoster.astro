---
// Byte as a pre-rendered still of the 3D robot (scripts/render-poster.mjs), so the first paint,
// reduced motion, save-data, no-WebGL and pages without Three.js all show the same HD robot.
interface Props { class?: string; priority?: boolean; sizes?: string; }
const { class: className = '', priority = false, sizes = '(min-width: 1024px) 460px, 80vw' } = Astro.props;
---
<img
  class={`poster-float ${className}`}
  src="/byte/poster-960.webp"
  srcset="/byte/poster-480.webp 480w, /byte/poster-960.webp 960w"
  sizes={sizes}
  width="960"
  height="960"
  alt="Byte, a small mint robot waving hello"
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
/>
<style>
  .poster-float { animation: poster-float 4.2s ease-in-out infinite; }
  @keyframes poster-float { 50% { transform: translateY(-1.6%); } }
  @media (prefers-reduced-motion: reduce) { .poster-float { animation: none; } }
</style>
