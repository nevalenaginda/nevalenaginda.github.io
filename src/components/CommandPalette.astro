---
const links = [
  ['Home', '/'], ['Viewport and HUD', '/#viewport'], ['System architecture (skills)', '/#specs'], ['Deployed missions (selected work)', '/#missions'],
  ['Flight log (experience)', '/#log'], ['Education', '/#education'], ['Comms terminal (contact)', '/#contact'], ['Printable CV', '/cv'],
  ['Pay on Schedule', '/projects/pay-on-schedule/'], ['Jenius Bisniskit', '/projects/bisniskit/'], ['Face Recognition', '/projects/face-recognition/'],
];
---
<dialog id="command-palette" class="no-print m-auto w-[min(92vw,38rem)] overflow-hidden rounded-2xl border border-line-bright bg-hull p-0 text-ink shadow-2xl backdrop:bg-void/70 backdrop:backdrop-blur-sm" aria-labelledby="palette-title">
  <div class="border-b border-line p-5">
    <p id="palette-title" class="hud-label !text-teal">Navigation computer</p>
    <label class="mt-3 block"><span class="sr-only">Filter destinations</span><input data-palette-input class="min-h-12 w-full rounded-xl border border-line bg-space px-4 font-mono text-sm text-ink outline-none placeholder:text-muted focus:border-teal" placeholder="Type to filter destinations…" /></label>
  </div>
  <ul class="max-h-[55vh] overflow-auto p-2" data-palette-list>
    {links.map(([label, href]) => <li><a class="block min-h-11 rounded-xl px-4 py-2.5 font-medium text-body no-underline transition-colors hover:bg-hull-2 hover:text-teal focus-visible:bg-hull-2" href={href}>{label}</a></li>)}
  </ul>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#command-palette');
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const open = () => { dialog?.showModal(); input?.focus(); };
  document.querySelector('[data-palette-open]')?.addEventListener('click', open);
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); }
    if (event.key === 'Escape' && dialog?.open) dialog.close();
  });
  input?.addEventListener('input', () => {
    const value = input.value.toLowerCase();
    document.querySelectorAll('[data-palette-list] li').forEach((item) => { (item as HTMLElement).hidden = !item.textContent?.toLowerCase().includes(value); });
  });
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  // Picking a destination closes the palette, so the page can scroll to it.
  dialog?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) dialog.close(); });
</script>
